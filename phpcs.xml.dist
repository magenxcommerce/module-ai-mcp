<?xml version="1.0"?>
<ruleset name="Magenx_AiMcp">
    <description>Magento 2 coding standard for Magenx_AiMcp.</description>

    <arg name="extensions" value="php,phtml,xml,js"/>
    <arg name="severity" value="8"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <!--
        Scan the whole module rather than naming directories, so this file is
        identical across every magenxcommerce/module-* repo. PSR-4 maps the
        module namespace to the repo root, so the excludes below are what keeps
        tooling and dependencies out.
    -->
    <file>.</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <!--
        The unit suite's harness: a bootstrap that maps the module's PSR-4
        prefix onto the checkout, and hand-written stand-ins for the Magento
        types the tests touch, used when magento/framework is not installed.
        Neither is module code — the bootstrap does the file manipulation the
        standard exists to discourage inside a module, and the stand-ins copy
        third-party signatures — so the Magento standard has nothing useful to
        say about either.
    -->
    <exclude-pattern>*/Test/Unit/_harness/*</exclude-pattern>
    <exclude-pattern>*/.git/*</exclude-pattern>
    <exclude-pattern>*/.github/*</exclude-pattern>

    <rule ref="Magento2"/>
</ruleset>
