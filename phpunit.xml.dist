<?xml version="1.0" encoding="UTF-8"?>
<!--
    The shared CI workflow generates a configuration of its own when a module
    has none, and that generated bootstrap maps only the module's PSR-4
    prefix. This suite also needs the Magento stand-ins, so the module carries
    its own configuration and the workflow uses it instead.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="Test/Unit/_harness/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="unit">
            <directory suffix="Test.php">Test/Unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
