<?xml version="1.0"?>
<!--
/**
 * Copyright © Magenx. All rights reserved.
 *
 * Magenx_AiMcp::server is what an Integration must be granted to reach the MCP
 * endpoint at all. Individual tools additionally require the stock ACL
 * resource for the data they touch (Magento_Catalog::products,
 * Magento_Cms::block, Magento_Config::config, Magento_Sales::invoice,
 * Magento_Sales::creditmemo, ...), so an integration can be scoped to exactly
 * the surface it should manage. The sales resources are the finest grained of
 * these on purpose: refunding is a separate grant from invoicing, which is a
 * separate grant from viewing an order. Magenx_AiMcp::ops, ::reports and ::logs are the
 * resources this module defines for tools of its own: diagnostics, aggregate figures and log
 * reading, none of which Magento has a resource for.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magenx_AiMcp::server" title="AI MCP Server" translate="title" sortOrder="200">
                    <!--
                        Cron state, the module list and this server's own audit log have no stock
                        Magento resource that fits them. Defaulting those to the endpoint grant
                        would mean any integration able to reach the server could read them, so
                        they get a resource of their own, nested here because they describe this
                        server rather than any part of the catalogue or the store.
                    -->
                    <resource id="Magenx_AiMcp::ops" title="AI MCP Server Diagnostics" translate="title" sortOrder="10"/>
                    <!--
                        Aggregate sales figures. Deliberately its own grant rather than
                        Magento_Sales::actions_view, which every order-reading tool uses:
                        "what did we take last month" and "show me this customer's order"
                        are different permissions, which is why Magento's own reports sit
                        under a tree of their own. Declared here rather than borrowed from
                        Magento_Reports because that module is not a dependency of this one
                        and none of its code is used — the figures are computed directly.
                    -->
                    <resource id="Magenx_AiMcp::reports" title="AI MCP Server Reports" translate="title" sortOrder="20"/>
                    <!--
                        The Magento logs in var/log and the error reports in var/report. Not
                        folded into ops, which describes the installation: these hold whatever
                        any module chose to write, customer e-mail addresses, request payloads
                        and the occasional credential among them. The tools mask what they can
                        recognise, but masking is best effort, so reading them is a grant an
                        integration has to be given on purpose.
                    -->
                    <resource id="Magenx_AiMcp::logs" title="AI MCP Server Logs" translate="title" sortOrder="30"/>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Magenx_AiMcp::config" title="AI MCP Server Section" translate="title" sortOrder="120"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
