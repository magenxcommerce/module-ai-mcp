<?xml version="1.0"?>
<!--
/**
 * Copyright © Magenx. All rights reserved.
 *
 * Every switch defaults to the safe value: the endpoint is off, writes are off,
 * and the config-write allowlist is empty (which denies every config write).
 * A valid integration token is never sufficient on its own.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <magenx_ai_mcp>
            <general>
                <enabled>0</enabled>
            </general>
            <security>
                <allow_writes>0</allow_writes>
                <allowed_ips/>
                <allowed_config_paths/>
                <allowed_origins/>
            </security>
            <!--
                Both empty, which here means "offer every tool". This is the one
                setting in the module that is not default-deny, and deliberately
                so: an empty domain list has to keep meaning "all", or upgrading
                an existing installation would silently empty tools/list. It is
                safe because neither field is a boundary — ACL and the write
                switch still decide what a caller may reach.
            -->
            <tools>
                <enabled_domains/>
                <disabled_tools/>
            </tools>
        </magenx_ai_mcp>
    </default>
</config>
