<?xml version="1.0"?>
<!--
/**
 * Copyright © Magenx. All rights reserved.
 *
 * Every switch defaults to the safe value: the endpoint is off, writes are off,
 * and the config-write allowlist is empty (which denies every config write).
 * A valid integration token is never sufficient on its own.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <magenx_ai_mcp>
            <general>
                <enabled>0</enabled>
            </general>
            <security>
                <allow_writes>0</allow_writes>
                <allowed_ips/>
                <allowed_config_paths/>
                <allowed_origins/>
                <audit_reads>off</audit_reads>
                <!-- Per caller, per minute. Far above what an agent working a task
                     needs; low enough to stop one stuck in a loop. 0 disables. -->
                <rate_limit>120</rate_limit>
                <write_rate_limit>30</write_rate_limit>
            </security>
            <!--
                Both empty, which here means "offer every tool". This is the one
                setting in the module that is not default-deny, and deliberately
                so: an empty domain list has to keep meaning "all", or upgrading
                an existing installation would silently empty tools/list. It is
                safe because neither field is a boundary — ACL and the write
                switch still decide what a caller may reach.
            -->
            <!--
                OAuth is off. When on, only claude.ai's callback may be registered,
                loopback callbacks are refused, and an empty public base URL means
                the default store's secure base URL.
            -->
            <oauth>
                <enabled>0</enabled>
                <allowed_redirect_uris>https://claude.ai/api/mcp/auth_callback
https://claude.com/api/mcp/auth_callback</allowed_redirect_uris>
                <allow_loopback_redirects>0</allow_loopback_redirects>
                <access_token_lifetime>60</access_token_lifetime>
                <refresh_token_lifetime>30</refresh_token_lifetime>
                <public_base_url/>
            </oauth>
            <tools>
                <enabled_domains/>
                <disabled_tools/>
            </tools>
        </magenx_ai_mcp>
    </default>
</config>
