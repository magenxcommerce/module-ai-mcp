    <!-- Every attempted write lands in var/log/magenx_ai_mcp.log, separate from
         the general log so an operator can audit agent activity on its own. -->
    <virtualType name="MagenxAiMcpAuditHandler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/magenx_ai_mcp.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="MagenxAiMcpAuditLogger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">magenxAiMcp</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">MagenxAiMcpAuditHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Magenx\AiMcp\Model\Protocol\Server">
        <arguments>
            <argument name="auditLogger" xsi:type="object">MagenxAiMcpAuditLogger</argument>
            <!-- Advertised to the MCP client as serverInfo.version. Kept here rather
                 than as a class constant so release-please's version bump has one
                 obvious place to land. -->
            <argument name="serverVersion" xsi:type="string">1.0.0</argument>
        </arguments>
    </type>

    <!-- Refused requests never reach the Server, so the authenticator needs the
         audit logger of its own to make a failed token or a blocked address
         visible in the same file as the writes. -->
    <type name="Magenx\AiMcp\Model\Auth\Authenticator">
        <arguments>
            <argument name="auditLogger" xsi:type="object">MagenxAiMcpAuditLogger</argument>
        </arguments>
    </type>
</config>
